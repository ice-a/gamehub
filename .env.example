# MongoDB 连接串
MONGODB_URI=mongodb://192.168.28.9:27017
# 目标数据库名（默认 gamehub，可显式指定以区分环境）
MONGODB_DB=gamehub

# AI 接口（OpenAI 兼容 /v1/chat/completions，用于生成游戏）
AI_API_KEY=sk-your-key
AI_BASE_URL=https://api.openai.com/v1
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_MS=120000

# 优化提示词专用大模型（独立模型，可选；留空则复用上面的 AI_* 配置）
OPT_AI_API_KEY=sk-your-key
OPT_AI_BASE_URL=https://api.openai.com/v1
OPT_AI_MODEL=gpt-4o-mini
OPT_AI_TIMEOUT_MS=120000

# 用于 sign 哈希的盐/密钥
APP_SECRET=gamehub-default-secret
